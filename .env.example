# GOOGLE PROVIDER ----------------------------------
MODEL="google/gemini-3.7-flash"
SUB_AGENT_MODEL="google/gemini-3.5-flash-lite"
GEMINI_API_KEY=""


# OPENROUTER PROVIDER ------------------------------
MODEL="openrouter/z-ai/glm-5.3-flash"
SUB_AGENT_MODEL="openrouter/qwen/qwen3.8-27b"
OPENROUTER_API_KEY=""


# OPENCODE PROVIDER --------------------------------
MODEL="opencode/hy3-free"
SUB_AGENT_MODEL="opencode-zen/mimo-v2.5-free"
OPENCODE_API_KEY=""

# ------------------------------------------------------------------
# UNIFIED MULTI-PROVIDER LAYER (OpenRouter-style, no 5% fee)
# Any OpenAI-compatible endpoint works with ZERO SDK changes.
# Just set MODEL="<prefix>/<model-id>" + {PREFIX}_API_KEY + {PREFIX}_BASE_URL.
# ------------------------------------------------------------------

# Example: Groq (direct, no OpenRouter markup)
# MODEL="groq/llama-3.3-70b-versatile"
# SUB_AGENT_MODEL="groq/qwen-qwq-32b"
# GROQ_API_KEY="gsk_..."
# GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Example: Cerebras
# MODEL="cerebras/gpt-oss-120b"
# CEREBRAS_API_KEY="csk-..."
# CEREBRAS_BASE_URL="https://api.cerebras.ai/v1"

# Example: Together AI
# MODEL="together/meta-llama/Llama-3.3-70B-Instruct-Turbo"
# TOGETHER_API_KEY="..."
# TOGETHER_BASE_URL="https://api.together.xyz/v1"

# Example: Local Ollama (no key needed)
# MODEL="ollama/qwen2.5-coder"
# OLLAMA_BASE_URL="http://localhost:11434/v1"
# OLLAMA_API_KEY="ollama"

# Single-endpoint escape hatch (bare MODEL_ID, no prefix needed):
# OPENAI_BASE_URL="https://your-proxy/v1  (or http://localhost:11434/v1)"
# OPENAI_BASE_API_KEY="sk-... (or anything for local)"
# MODEL="llama-3.3-70b"
