# API keys only. Since 0.7.0 nothing else is read from the environment:
# models, endpoints, limits and options are set in code (see docs/guides/settings.md).

# GOOGLE PROVIDER ----------------------------------
GEMINI_API_KEY=

# OPENROUTER PROVIDER ------------------------------
OPENROUTER_API_KEY=

# ANTHROPIC PROVIDER -------------------------------
ANTHROPIC_API_KEY=

# OPENAI PROVIDER ----------------------------------
OPENAI_API_KEY=
# or, for a proxy that uses its own key name:
# OPENAI_BASE_API_KEY=

# ------------------------------------------------------------------
# Any OpenAI-compatible endpoint: its key is {PREFIX}_API_KEY, and its
# endpoint is the `base_urls.<prefix>` setting in code, e.g.
#   setConfigs({ values: { base_urls: { groq: "https://api.groq.com/openai/v1" } } })
# Local endpoints (Ollama, vLLM on localhost) may omit the key.
# ------------------------------------------------------------------
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# TOGETHER_API_KEY=
# OLLAMA_API_KEY=
